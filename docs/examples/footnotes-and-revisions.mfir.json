        "children": [
          { "type": "text", "id": "n_ddddddddddddddddtxaa:0", "value": "The estimator converges in " },
          { "type": "inlineMath", "id": "n_ddddddddddddddddimaa:0", "value": "O(n \\log n)" },
          { "type": "text", "id": "n_ddddddddddddddddtxab:0", "value": " time" },
          { "type": "footnoteReference", "id": "n_ddddddddddddddddfraa:0", "identifier": "1", "label": "1" },
          { "type": "text", "id": "n_ddddddddddddddddtxac:0", "value": " under the assumptions of " },
          {
            "type": "crossReference",
            "id": "n_ddddddddddddddddxraa:0",
            "kind": "equation",
            "targetKey": "eq:regularity",
            "label": "Equation 4"
          },
          { "type": "text", "id": "n_ddddddddddddddddtxad:0", "value": "." }
        ]
      },
      {
        "type": "paragraph",
        "id": "n_ddddddddddddddddprab:0",
        "children": [
          { "type": "text", "id": "n_ddddddddddddddddtxae:0", "value": "We report results on " },
          {
            "type": "comment",
            "id": "n_ddddddddddddddddcmaa:0",
            "commentId": "c17",
            "author": "R. Okafor",
            "date": "2026-06-11T14:22:00Z",
