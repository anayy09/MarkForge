                  "children": [{ "type": "text", "id": "n_ddddddddddddddddcbta:0", "value": "Should this be three datasets? Check against Table 2." }]
                }
              ]
            },
            "children": [
              { "type": "text", "id": "n_ddddddddddddddddtxaf:0", "value": "two public datasets" }
            ]
          },
          { "type": "text", "id": "n_ddddddddddddddddtxag:0", "value": " and " },
          {
            "type": "insertion",
            "id": "n_ddddddddddddddddinaa:0",
            "author": "R. Okafor",
            "date": "2026-06-11T14:24:00Z",
            "revisionId": "rev41",
            "children": [
              { "type": "text", "id": "n_ddddddddddddddddtxah:0", "value": "one proprietary corpus" }
            ]
          },
          {
            "type": "deletion",
            "id": "n_ddddddddddddddddddaa:0",
            "author": "R. Okafor",
            "date": "2026-06-11T14:24:00Z",
            "revisionId": "rev42",
            "children": [
              { "type": "text", "id": "n_ddddddddddddddddtxai:0", "value": "an internal benchmark" }
            ]
