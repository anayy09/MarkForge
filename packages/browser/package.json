{
  "name": "@markforge/browser",
  "version": "0.1.0",
  "private": true,
  "description": "The browser entry point: bytes in, bytes out, no filesystem (ADR-0015)",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./pdf": {
      "types": "./dist/pdf.d.ts",
      "default": "./dist/pdf.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "dependencies": {
    "@markforge/agentify": "workspace:*",
    "@markforge/core": "workspace:*",
    "@markforge/ir": "workspace:*",
    "@markforge/render-pdf": "workspace:*"
  },
  "markforge": {
    "browserTier": "eager",
    "browserEntry": true
  }
}
