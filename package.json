{
  "name": "markforge-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Markdown toolkit: agent context compiler + fidelity-preserving conversion",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b --pretty",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:docs": "node scripts/check-docs.mjs",
    "check:schemas": "node scripts/check-schemas.mjs",
    "check:fixtures": "node scripts/check-fixtures.mjs",
    "check:corpus": "node scripts/build-messy-fixtures.mjs --check",
    "check:corpus-docx": "node scripts/build-corpus-fixtures.mjs --check",
    "check:agentify-corpus": "node scripts/build-agentify-corpus.mjs --check",
    "check:agentify": "node scripts/check-agentify.mjs",
    "check:browser": "node scripts/check-browser-bundle.mjs",
    "check:retention": "node scripts/check-http-retention.mjs",
    "check:parity": "node scripts/check-surface-parity.mjs",
    "check:templates": "node scripts/build-reference-templates.mjs --check",
    "check:markdown": "node scripts/check-markdown-lint.mjs",
    "check:mammoth": "node scripts/diff-mammoth.mjs --check",
    "codegen": "node scripts/codegen-types.mjs",
    "fidelity": "node scripts/run-fidelity.mjs",
    "dev:web": "pnpm --filter @markforge/web run dev",
    "build:web": "pnpm --filter @markforge/web run build",
    "typecheck:web": "pnpm --filter @markforge/web run typecheck",
    "verify": "pnpm run check:docs && pnpm run check:schemas && pnpm run check:fixtures && pnpm run check:corpus && pnpm run check:corpus-docx && pnpm run check:agentify-corpus && pnpm run typecheck && pnpm run check:markdown && pnpm run check:mammoth && pnpm run test && pnpm run build && pnpm run check:scanned-corpus && pnpm run check:templates && pnpm run check:agentify && pnpm run check:browser && pnpm run check:retention && pnpm run check:parity && pnpm run check:degradation && pnpm run check:merge-predicate && pnpm run check:contamination && pnpm run check:tests && pnpm run check:adr && pnpm run check:status && pnpm run check:target-docs && pnpm run check:gate-parity && pnpm run check:gates && pnpm run check:node-types && pnpm run check:ir-structure && pnpm run check:flavors && pnpm run check:pdf && pnpm run check:hook && pnpm run check:producers && pnpm run check:templates-strict && pnpm run check:pdf-fonts && pnpm run check:fidelity && pnpm run typecheck:web",
    "check:scanned-corpus": "node scripts/build-scanned-fixtures.mjs --check",
    "check:gate-parity": "node scripts/check-gate-parity.mjs",
    "check:gates": "node scripts/check-gates.mjs",
    "check:node-types": "node scripts/check-node-type-coverage.mjs",
    "check:ir-structure": "node scripts/check-ir-structure.mjs",
    "check:flavors": "node scripts/check-flavor-distinctness.mjs",
    "check:pdf": "node scripts/check-pdf-determinism.mjs",
    "check:hook": "node scripts/check-hook.mjs",
    "check:producers": "node scripts/check-producer-exports.mjs",
    "check:templates-strict": "node scripts/check-template-strict.mjs",
    "install-hooks": "node scripts/install-hooks.mjs",
    "check:fidelity": "node scripts/run-fidelity.mjs --check",
    "check:degradation": "node scripts/check-degradation.mjs",
    "check:merge-predicate": "node scripts/check-merge-predicate.mjs",
    "check:adr": "node scripts/check-adr-enforcement.mjs",
    "check:status": "node scripts/check-status-claims.mjs",
    "check:target-docs": "node scripts/check-target-docs.mjs",
    "check:contamination": "node scripts/check-fixture-contamination.mjs",
    "check:tests": "node scripts/check-test-collection.mjs",
    "check:pdf-fonts": "node scripts/check-pdf-fonts.mjs"
  },
  "devDependencies": {
    "@myriaddreamin/typst-ts-node-compiler": "0.7.0",
    "@myriaddreamin/typst-ts-web-compiler": "0.7.0",
    "@myriaddreamin/typst.ts": "0.7.0",
    "@types/node": "^22.10.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "esbuild": "^0.28.1",
    "fast-check": "^3.23.2",
    "json-schema-to-typescript": "^15.0.4",
    "mammoth": "^1.12.0",
    "markdownlint": "^0.41.1",
    "pdfjs-dist": "^4.10.38",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "word-to-markdown": "0.3.0"
  },
  "devDependenciesComment": "The install-script allowlist lives in pnpm-workspace.yaml (allowBuilds), not here."
}
